{
  "name": "katashiro-dev",
  "private": true,
  "description": "Dev tooling only (tests and puppeteer smokes). The extension itself has no dependencies and never loads anything from node_modules.",
  "engines": {
    "node": ">=22.12.0"
  },
  "config": {
    "chromeVersion": "155.0.8059.39"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "chrome": "npx --no-install @puppeteer/browsers install chrome-headless-shell@$npm_package_config_chromeVersion --path .cache/chrome",
    "smoke": "node scripts/run-smokes.mjs"
  },
  "devDependencies": {
    "@puppeteer/browsers": "3.2.4",
    "puppeteer-core": "25.13.0"
  }
}
